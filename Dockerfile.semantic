FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/huggingface \
    TRANSFORMERS_CACHE=/models/huggingface

WORKDIR /app

COPY requirements-semantic.txt ./
# FlagEmbedding accepts an existing torch installation.  Install the official
# CPU wheel first so a CPU-only host never downloads CUDA/NVIDIA packages.
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.9.1 \
    && pip install -r requirements-semantic.txt

COPY semantic_service ./semantic_service

EXPOSE 8010
CMD ["uvicorn", "semantic_service.app:app", "--host", "0.0.0.0", "--port", "8010"]
