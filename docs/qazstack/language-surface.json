{
  "schema_version": "qazstack-language-surface-v1",
  "project_id": "qaz-fund",
  "canonical_locales": ["kk", "ru", "en"],
  "locale_transport": "query:lang",
  "aliases": {
    "kk": ["kk", "kk-KZ", "kz", "kaz", "kaz_Cyrl", "kazakh"],
    "ru": ["ru", "ru-RU", "rus", "russian"],
    "en": ["en", "en-US", "eng", "english"]
  },
  "surfaces": {
    "dashboard": {"locales": ["kk", "ru", "en"], "fallback": "ru"},
    "opportunity_detail": {"locales": ["kk", "ru", "en"], "fallback": "ru"},
    "funder_detail": {"locales": ["kk", "ru", "en"], "fallback": "ru"},
    "public_info": {"locales": ["kk", "ru", "en"], "fallback": "ru"},
    "error_page": {"locales": ["kk", "ru", "en"], "fallback": "ru"},
    "operator": {"locales": ["kk", "ru", "en"], "fallback": "ru", "robots": "noindex"}
  },
  "content_policy": {
    "canonical_storage": "raw.i18n.{locale}",
    "source_text_preserved": true,
    "missing_translation": "show_source_or_safe_fallback_without_claiming_editorial_translation",
    "automatic_translation_publishing": false,
    "quality_owner": "qdev-platform"
  }
}
