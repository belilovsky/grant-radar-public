# Copy to .env and fill in real values. NEVER commit secrets.

POSTGRES_PASSWORD=local-development-password
DATABASE_URL=postgresql+psycopg://grantradar:local-development-password@db:5432/grantradar
# Repository backend for grant-radar (used by core.repository_factory.make_repository)
# Leave empty / set to "memory" to use in-process InMemoryRepository (tests/dev).
# Use sqlite:///./data/grants.db for local file persistence,
# or postgresql+psycopg://... to share with DATABASE_URL above.
GRANT_RADAR_DB_URL=sqlite:///./data/grants.db
# Public origin used for canonical links and share pages.
PUBLIC_BASE_URL=http://localhost:8000
ROOT_PATH=
GRANT_RADAR_ADMIN_TOKEN=

# Misc
LOG_LEVEL=INFO
GRANT_RADAR_TIME_ZONE=Asia/Almaty
WEB_CONCURRENCY=2
PUBLIC_ITEMS_CACHE_TTL_SECONDS=300
INSIGHTS_CACHE_TTL_SECONDS=60

# Internal-only BGE-M3 + Qdrant service.  Production Compose enables this
# service; development remains lexical until an explicit local URL is set.
GRANT_RADAR_SEMANTIC_SEARCH_ENABLED=0
GRANT_RADAR_SEMANTIC_SEARCH_URL=
GRANT_RADAR_SEMANTIC_TIMEOUT_SECONDS=2
GRANT_RADAR_SEMANTIC_REINDEX_INTERVAL_SECONDS=21600
GRANT_RADAR_SEMANTIC_RERANK_LIMIT=50

# Worker
GRANT_RADAR_SOURCES=grants_gov,astana_hub,internews,isdb_project_procurement,ebrd_ecepp_procurement,erasmus_kazakhstan,opportunity_desk,fundsforngos,kazakhstan_domestic_support,kazakhstan_watch,eeas_kazakhstan,world_bank_kazakhstan,world_bank_procurement_ca,eu_funding_tenders_ca,canada_cfli_ca,undp_procurement,adb_kazakhstan,google_cloud_startup,microsoft_founders_hub,aws_activate,nvidia_inception,cloudflare_startups,mongodb_startups,unicef_kazakhstan,google_org_ai_opportunity,unesco_iite
GRANT_RADAR_SOURCE_INTERVAL_SECONDS=21600
GRANT_RADAR_MAX_SOURCE_CONCURRENCY=4
GRANT_RADAR_MIGRATION_ATTEMPTS=30
GRANT_RADAR_MIGRATION_SLEEP_SECONDS=2
